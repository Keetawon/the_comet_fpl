{
  "name": "the-comet-manager-import",
  "main": "manager-import.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "manager-api.thecometfpl.com", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.thecometfpl.com,https://thecometfpl.com,https://keetawon.github.io"
  },
  "ratelimits": [{
    "name": "IMPORT_RATE_LIMITER",
    "namespace_id": "91701",
    "simple": { "limit": 20, "period": 60 }
  }],
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 10 }
}
