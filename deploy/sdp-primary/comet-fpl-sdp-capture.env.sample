# Sample for /etc/default/comet-fpl-sdp (systemd EnvironmentFile).
# Operator-managed sample paths only. No credential, token, or key belongs in this file,
# in unit files, in receipts, or in any log: the SDP backend is a public provider backend
# and this runtime uses no secret. Copy to the real path and edit the values.

# Explicit persistent operational database. Never the repository default/research database.
SDP_DB=/var/lib/comet-fpl/db/operational.duckdb

# Persistent receipt root: one directory per run, reports/logs/backups retained.
SDP_RUNS=/var/lib/comet-fpl/runs

# Exact V2-branch commit the checkout must be at; the services refuse to start otherwise.
SDP_CODE_PIN=0000000000000000000000000000000000000000

# Explicit staleness bound in hours for the health check (daily schedule plus slack).
# Must be finite and positive. Operational choice, not a scientific threshold;
# adjust per operator policy.
SDP_HEALTH_MAX_AGE_HOURS=30

PYTHONUNBUFFERED=1
